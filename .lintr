linters: linters_with_defaults(
    line_length_linter(80),
    object_name_linter = NULL,
    object_length_linter = NULL
  )
exclusions: list(
    # Generated by Rcpp / rstantools — never hand-styled.
    "R/RcppExports.R",
    "R/stanmodels.R",
    # Mirrors helpers in the celda package; kept byte-aligned with celda
    # to minimise cross-package divergence (see AGENTS.md), so it is not
    # restyled to decontX's conventions.
    "R/celda_functions.R",
    # Vignettes are prose + example code, knit locally and not exercised
    # by R CMD check; their chunk style is not part of the blocking lint.
    "vignettes/decontX.Rmd",
    "vignettes/decontPro.Rmd"
  )
encoding: "UTF-8"
