{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(make test-one:*)",
      "Bash(make check)",
      "Bash(make check-full)",
      "Bash(make bioccheck)",
      "Bash(make docs)",
      "Bash(make lint)",
      "Bash(make coverage)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git blame:*)",
      "Bash(git remote -v)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Edit(man/*.Rd)",
      "Write(man/*.Rd)",
      "Edit(NAMESPACE)",
      "Write(NAMESPACE)",
      "Edit(docs/**)",
      "Write(docs/**)",
      "Edit(R/RcppExports.R)",
      "Write(R/RcppExports.R)",
      "Edit(src/RcppExports.cpp)",
      "Write(src/RcppExports.cpp)",
      "Edit(R/stanmodels.R)",
      "Write(R/stanmodels.R)",
      "Edit(src/stanExports_*)",
      "Write(src/stanExports_*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(git push bioc:*)",
      "Bash(git reset --hard:*)",
      "Bash(make * -*)",
      "Bash(git switch -f*)",
      "Bash(git switch * -f*)",
      "Bash(git switch --force*)",
      "Bash(git switch * --force*)",
      "Bash(git switch --discard-changes*)",
      "Bash(git switch * --discard-changes*)",
      "Bash(git switch -C*)",
      "Bash(git switch * -C*)",
      "Bash(git checkout -f*)",
      "Bash(git checkout * -f*)",
      "Bash(git checkout --force*)",
      "Bash(git checkout * --force*)",
      "Bash(git branch -d*)",
      "Bash(git branch * -d*)",
      "Bash(git branch -D*)",
      "Bash(git branch * -D*)",
      "Bash(git branch -f*)",
      "Bash(git branch * -f*)",
      "Bash(git branch --delete*)",
      "Bash(git branch * --delete*)",
      "Bash(git branch --force*)",
      "Bash(git branch * --force*)",
      "Bash(git branch -M*)",
      "Bash(git branch * -M*)",
      "Bash(make clean)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(Makefile)",
      "Write(Makefile)",
      "Edit(dev/hooks/**)",
      "Write(dev/hooks/**)",
      "Edit(.lintr)",
      "Write(.lintr)",
      "Edit(~/.cache/r-bioc-dev-standards/**)",
      "Write(~/.cache/r-bioc-dev-standards/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash dev/hooks/load-standards.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash dev/hooks/lint-changed.sh"
          }
        ]
      }
    ]
  }
}
