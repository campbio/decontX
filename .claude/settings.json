{
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(make check)",
      "Bash(make bioccheck)",
      "Bash(make docs)",
      "Bash(make lint)",
      "Bash(make build)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git blame:*)"
    ],
    "deny": [
      "Edit(man/*.Rd)",
      "Write(man/**)",
      "Edit(NAMESPACE)",
      "Write(NAMESPACE)",
      "Edit(docs/**)",
      "Write(docs/**)",
      "Edit(R/RcppExports.R)",
      "Write(R/RcppExports.R)",
      "Edit(src/RcppExports.cpp)",
      "Write(src/RcppExports.cpp)",
      "Edit(R/stanmodels.R)",
      "Write(R/stanmodels.R)",
      "Edit(src/stanExports_*)",
      "Write(src/stanExports_*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash dev/hooks/lint-changed.sh"
          }
        ]
      }
    ]
  },
  "env": {
    "_R_CHECK_FORCE_SUGGESTS_": "false"
  }
}
